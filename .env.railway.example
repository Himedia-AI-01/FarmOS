# ────────────────────────────────────────────────────────────────────────────
# Railway environment variables — FarmOS-v2
# Copy each block into the matching service's "Variables" tab in Railway.
# Postgres / Redis URLs come from Railway's plugin references (see RAILWAY.md).
# ────────────────────────────────────────────────────────────────────────────

# ============================================================================
# SERVICE: backend
# ============================================================================

# ── App ────────────────────────────────────────────────────────────────────
PROJECT_NAME=FarmOS
API_V1_PREFIX=/api/v1
APP_TIMEZONE=Asia/Seoul
DEBUG=false

# ── Persistence (Railway Volume mounted at /data) ──────────────────────────
CHROMA_DB_PATH=/data/chroma
UPLOAD_BASE_DIR=/data/uploads

# ── Postgres (link plugin: ${{Postgres.DATABASE_URL}}) ─────────────────────
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Redis (link plugin: ${{Redis.REDIS_URL}}) ──────────────────────────────
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_POOL_MAX_CONNECTIONS=16
SUBSIDY_RAG_BACKEND=chroma   # set "redis" once Redis Stack 8.4+ index is built

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-32-byte-random-string
COOKIE_SECURE=true

# ── CORS — must match the frontend service public URL ─────────────────────
CORS_ORIGINS=["https://<frontend>.up.railway.app"]

# ── Public-data APIs ───────────────────────────────────────────────────────
KMA_DECODING_KEY=
NCPMS_API_KEY=
PESTICIDE_API_KEY=
FOOD_SAFETY_API_KEY=
KAMIS_API_KEY=
KAMIS_CERT_ID=
KAKAO_REST_API_KEY=

# ── LLM providers ──────────────────────────────────────────────────────────
LITELLM_API_KEY=
LITELLM_URL=
LITELLM_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=x-ai/grok-4.1-fast
OPENROUTER_REASONING_ENABLED=false
GROQ_API_KEY=
GROQ_STT_URL=
GROQ_STT_MODEL=
UPSTAGE_API_KEY=

# ── Farm-Agent profile ─────────────────────────────────────────────────────
FARM_AGENT_PROFILE=balanced
LITELLM_VISION_MODEL=gpt-5-mini

# ── External services ──────────────────────────────────────────────────────
PEST_CLASSIFIER_URL=
IOT_RELAY_BASE_URL=
IOT_RELAY_API_KEY=
AI_AGENT_BRIDGE_ENABLED=false

# ── Optional: LangSmith tracing ────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=farmos-deepagent

# ── Optional: LangCache (semantic LLM cache) ───────────────────────────────
LANGCACHE_API_KEY=
LANGCACHE_CACHE_ID=
LANGCACHE_ENABLED=false

# ── Optional: MCP servers ──────────────────────────────────────────────────
MCP_SERVERS_JSON=
MCP_SERVER_ENABLED=false

# ============================================================================
# SERVICE: frontend (Vite build-time vars — must be set BEFORE deploy)
# ============================================================================
# Use the backend service's public Railway domain.
VITE_FARMOS_API_BASE=https://<backend>.up.railway.app/api/v1
VITE_BACKEND_ORIGIN=https://<backend>.up.railway.app
VITE_API_BASE=https://<backend>.up.railway.app/api/v1
